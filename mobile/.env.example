# Explicit, public runtime configuration. Copy to the ignored .env.local only
# for interactive development; release commands should set reviewed values in
# the operator shell or build-provider environment.
EXPO_PUBLIC_APP_ENV=development
EXPO_PUBLIC_API_BASE_URL=http://<private-lan-host>:3000

# Optional providers fail closed. Enabling one also requires its documented
# build-only input; none of those inputs are application secrets prefixed with
# EXPO_PUBLIC_.
EXPO_PUBLIC_ENABLE_PEACH=false
EXPO_PUBLIC_PUSH_PROVIDER=disabled
EXPO_PUBLIC_MAPS_PROVIDER=disabled

# Local Gradle is the default APK provider. EAS remains optional.
ANDROID_BUILD_PROVIDER=local_gradle
ANDROID_PACKAGE_NAME=za.togt.app
TOGT_ANDROID_ABIS=arm64-v8a
TOGT_ANDROID_SIGNING_MODE=generated-debug
TOGT_ANDROID_EXPECTED_SIGNER_SHA256=FAC61745DC0903786FB9EDE62A962B399F7348F0BB6F899B8332667591033B9C
