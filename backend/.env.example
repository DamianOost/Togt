PORT=3000
DATABASE_URL=postgresql://user:password@localhost:5432/togt
# Independent random secrets (at least 32 bytes each). Never reuse either
# value for another purpose. Generate each separately, for example:
# node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
JWT_REFRESH_SECRET=
PEACH_ENTITY_ID=your_peach_entity_id
PEACH_ACCESS_TOKEN=your_peach_access_token
PEACH_BASE_URL=https://eu-test.oppwa.com

# CORS — comma-separated list of allowed origins. Leave empty in dev to allow any.
# Example: CORS_ORIGINS=https://togt.co.za,https://admin.togt.co.za
CORS_ORIGINS=

# Product approval is a separate, default-off gate. Enabling it requires the
# entity ID, access token, a valid HTTPS base URL, and the signed-webhook secret.
# Any missing gate/configuration returns 503 before transport or mutation;
# unsigned webhooks are never accepted.
PEACH_WEBHOOKS_ENABLED=false
PEACH_WEBHOOK_SECRET=

# Resend (password reset emails)
RESEND_API_KEY=
RESEND_FROM=Togt <onboarding@resend.dev>

# VerifyNow — SA DHA-linked ID verification (https://www.verifynow.co.za)
# Mode: sandbox or production. Provider configuration does not enable the KYC
# product capability; the reviewed capability gate remains separately off.
VERIFYNOW_API_KEY=
VERIFYNOW_MODE=sandbox

# Cloudinary profile images. Credentials alone do not enable the endpoint.
# Set the explicit gate only after the media/privacy/moderation review.
PROFILE_IMAGE_UPLOADS_ENABLED=false
# Exact approved HTTPS origin used when serializing public Worker photos.
# Cloudinary additionally requires the first URL path segment to match
# CLOUDINARY_CLOUD_NAME. Unset/invalid values make public photos unavailable.
PUBLIC_PROFILE_IMAGE_ORIGIN=
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Versioned registration documents. Production registration remains
# unavailable unless all four values are valid HTTPS/version values and the
# explicit approval flag is true.
REGISTRATION_TERMS_VERSION=
REGISTRATION_TERMS_URL=
REGISTRATION_PRIVACY_VERSION=
REGISTRATION_PRIVACY_URL=
REGISTRATION_POLICY_APPROVED=false

# Approved, versioned Worker education/acknowledgement content. Leaving any
# value unset keeps that activation item incomplete.
WORKER_FOREGROUND_LOCATION_EXPLANATION_VERSION=
WORKER_SAFETY_POLICY_VERSION=
WORKER_FIRST_JOB_READINESS_VERSION=

# Canonical accepted-Project fulfilment policy. This is a separate,
# default-off Operations approval gate. Quote or Fast Match acceptance returns
# 503 before any acceptance mutation unless approval is exactly `true` and
# every versioned policy value below passes the server's strict range checks.
# The only currently supported arrival evidence mode is worker_attestation.
GROUNDED_FULFILMENT_POLICY_APPROVED=false
GROUNDED_FULFILMENT_POLICY_VERSION=
GROUNDED_FULFILMENT_ROUTE_REVEAL_LEAD_MINUTES=
GROUNDED_FULFILMENT_ARRIVAL_EVIDENCE_MODE=
GROUNDED_FULFILMENT_NO_SHOW_GRACE_MINUTES=
GROUNDED_FULFILMENT_START_PIN_TTL_MINUTES=
GROUNDED_FULFILMENT_START_PIN_MAX_ATTEMPTS=
GROUNDED_FULFILMENT_RESCHEDULE_EXPIRY_MINUTES=
GROUNDED_FULFILMENT_CHANGE_ORDER_EXPIRY_MINUTES=

# Retired legacy POST /api/bookings compatibility. Grounded clients must use
# canonical quote requests or Fast Match. This remains default-off; set exactly
# `true` only for a time-bounded, reviewed legacy-client migration window.
LEGACY_DIRECT_BOOKING_CREATION_ENABLED=false

# 32 bytes (64 hex chars). Generate: node -e "console.log(require(\"crypto\").randomBytes(32).toString(\"hex\"))"
WEBHOOK_SECRET_ENCRYPTION_KEY=

# 32 bytes (64 hex chars). Used to create blind indexes for high-risk PII
# such as SA ID numbers without storing the raw value. Generate:
# node -e "console.log(require(\"crypto\").randomBytes(32).toString(\"hex\"))"
PII_BLIND_INDEX_KEY=

# OpenAPI / problem-detail base. Used in error type URIs and the
# servers[] block of the OpenAPI spec. Optional in dev (defaults to
# https://api.togt.co.za and http://localhost:3002).
API_PUBLIC_BASE_URL=
API_PUBLIC_HOST=

# Set to '1' to force the SSRF private-IP guard ON in non-production
# (e.g. CI). The guard is automatically on under NODE_ENV=production.
WEBHOOK_SSRF_FORCE=

# Set to '1' to force the rate limiters to apply in test mode (used by
# rateLimit.test.js to assert the limiter actually rejects). Without
# this, all limiters are no-ops under NODE_ENV=test.
RATELIMIT_FORCE=

# DB pool tuning — defaults are sane for single-process dev (10/30s/5s/15s).
# PG_POOL_MAX=10
# PG_IDLE_TIMEOUT_MS=30000
# PG_CONNECTION_TIMEOUT_MS=5000
# PG_STATEMENT_TIMEOUT_MS=15000

# Production PostgreSQL verifies the server certificate. Node's trust store is
# used by default; managed providers may inject an approved PEM chain here
# (use literal \n separators in one-line secret stores).
PG_SSL_CA=
